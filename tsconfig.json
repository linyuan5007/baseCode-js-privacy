{
  "include": ["src", "src/__test__"],
  "compilerOptions": {
    "types": ["jest", "node"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    "strict": false,
    "noImplicitAny": false,

    "isolatedModules": false,
    "skipLibCheck": true,

    "noEmit": true
  },
  "exclude": ["dist", "node_modules"],
}
